{
  "name": "auralis-relay",
  "version": "2.0.0",
  "private": true,
  "description": "Listen-together relay for Auralis: one room per code, providing the shared clock two phones cannot agree on by themselves. A plain Node WebSocket server, so it runs on any host that can run a container.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "node --watch --experimental-strip-types src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "check:turn": "node dist/check-turn.js"
  },
  "license": "ISC",
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
