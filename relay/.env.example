# Copy to .env for local runs; on a host, set these as environment variables or secrets.

PORT=8787

# Where rooms are kept. Empty means memory only — fine on a host with no disk, but a room code
# then lasts only until the next restart.
DATA_DIR=./data

# Whether someone arriving with a code this relay has never heard of gets the room anyway.
# Defaults to on when DATA_DIR is empty, because there a forgotten code is the relay's fault
# rather than a wrong one, and off when there is a disk, because there it really is missing.
# ADOPT_UNKNOWN_ROOMS=true

# --- Calls -------------------------------------------------------------------------------------
# Without a TURN server a call works whenever the two networks allow a direct connection and fails
# when they do not. `turns:` on 443 is the one that gets through a network hostile to calls.

# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:80?transport=tcp,turns:turn.example.com:443?transport=tcp
#
# A free public test service, if you have no TURN server of your own yet. Verify it before
# trusting it:  npm run build && npm run check:turn
# TURN_URLS=turn:openrelay.metered.ca:80,turn:openrelay.metered.ca:443,turns:openrelay.metered.ca:443?transport=tcp
# TURN_USERNAME=openrelayproject
# TURN_CREDENTIAL=openrelayproject

# Either a shared secret (coturn's `static-auth-secret`; the relay derives credentials that
# expire) ...
# TURN_SECRET=

# ... or the fixed username and password a hosted TURN provider gives you.
# TURN_USERNAME=
# TURN_CREDENTIAL=

# How long a derived credential lasts. Longer than any call, on purpose.
# TURN_TTL_SECONDS=43200

# Override the STUN servers if you would rather not use the public ones.
# STUN_URLS=stun:stun.example.com:3478
